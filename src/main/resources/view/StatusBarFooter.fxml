<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<!-- An HBox passes the remaining width to the path label, so a long data-file path wraps instead of being cut off. -->
<HBox styleClass="status-bar" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <Label fx:id="saveLocationStatus" wrapText="true" minWidth="10" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
  <Label fx:id="deletionStatus" minWidth="-Infinity" />
</HBox>
